OPENAI_API_KEY=sk-your-key-here

# ElevenLabs API key — used for voiceover/TTS
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Override defaults (optional)
# OPENAI_MODEL=gpt-4o-mini
